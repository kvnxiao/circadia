set shell := ["bash", "-uc"]
set windows-shell := ["bash", "-uc"]

ruff := "uvx --python 3.15 ruff@0.17.1"
ty := "uvx --python 3.15 ty@0.0.89"
python := "uv run --no-project --python 3.15 python -B"

python-check:
    {{ruff}} check .
    {{ruff}} format --check .
    {{ty}} check .

python-format:
    {{ruff}} format .

python-test:
    {{python}} windows-clock/windows_clock.py
    {{python}} -m unittest discover -s solar-timing -p 'test_*.py'
