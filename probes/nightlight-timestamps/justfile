set shell := ["bash", "-uc"]

fmt:
    cargo +nightly fmt --all

lint:
    cargo +nightly fmt --all --check
    cargo +stable clippy --all-targets --locked -- -D warnings

fix:
    cargo +stable clippy --fix --all-targets --locked --allow-dirty --allow-no-vcs
    just fmt
    just lint

test:
    cargo +stable test --locked

doc:
    RUSTDOCFLAGS="-D warnings" cargo +stable doc --no-deps --locked

dependencies:
    cargo +stable audit
    cargo +stable machete

check: lint test doc dependencies

check-msrv:
    #!/usr/bin/env bash
    set -euo pipefail
    metadata=$(cargo +stable metadata --no-deps --format-version 1 --locked)
    msrv=$(jq -er '.packages[0].rust_version // error("package must declare rust-version")' <<< "$metadata")
    cargo +"$msrv" check --all-targets --locked

build:
    cargo +stable build --locked

display:
    powershell.exe -NoProfile -ExecutionPolicy Bypass -File inspect-display.ps1

inspect: build
    powershell.exe -NoProfile -ExecutionPolicy Bypass -File run-probe.ps1 -InspectOnly

exercise: build
    powershell.exe -NoProfile -ExecutionPolicy Bypass -File run-probe.ps1

native-controls: build
    powershell.exe -NoProfile -ExecutionPolicy Bypass -File run-probe.ps1 -NativeControlsOnly
