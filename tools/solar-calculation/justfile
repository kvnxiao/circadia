set shell := ["bash", "-uc"]

fmt:
    cargo +nightly fmt --all

fmt-check:
    cargo +nightly fmt --all --check

clippy:
    cargo +stable clippy --all-targets --locked -- -D warnings

lint: fmt-check clippy

fix:
    cargo +stable clippy --fix --all-targets --locked --allow-dirty --allow-no-vcs
    just fmt
    just lint

test:
    cargo +stable test --locked

build-events:
    cargo +stable build --bin solar-events --locked

report:
    cargo +stable test --locked -- --nocapture

doc:
    RUSTDOCFLAGS="-D warnings" cargo +stable doc --no-deps --locked

dependencies:
    cargo +stable audit
    cargo +stable machete

check: lint test doc dependencies

check-msrv:
    #!/usr/bin/env bash
    set -euo pipefail
    metadata=$(cargo +stable metadata --no-deps --format-version 1 --locked)
    msrv=$(jq -er '.packages[0].rust_version // error("package must declare rust-version")' <<< "$metadata")
    cargo +"$msrv" check --all-targets --locked
